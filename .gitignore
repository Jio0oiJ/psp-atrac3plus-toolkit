# 白名单模式：默认全部忽略，只发布下面显式放行的文件
/*
!/.gitignore
!/README.md
!/at3_to_aa3.py
!/atrac3plus_gui.py
!/build_dist.py
!/make_icon.py
!/app.ico
!/oma_header.bin
!/psp_at3tool.exe
!/msvcr71.dll

# 便携版产物：根目录只留主程序，其余进 bin/
!/dist/
/dist/*
!/dist/ATRAC3plus转PSP.exe
!/dist/README.md
!/dist/bin/
/dist/bin/*
!/dist/bin/psp_at3tool.exe
!/dist/bin/msvcr71.dll
!/dist/bin/oma_header.bin

# dist/bin/ffmpeg.exe（100.54 MiB）超过 GitHub 单文件 100 MiB 上限，无法进版本库，
# 但会打进 Release 附件里，下载解压即为完整一套。

# 单文件版（约 125 MB）只在 Release 里发，不进版本库
/dist_single/

# 本机配置（含个人路径）、缓存，不上传
atrac3plus_gui.json
__pycache__/
*.pyc
